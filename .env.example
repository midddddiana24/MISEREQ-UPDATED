APP_NAME="MIS Service Request System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://service-campus.example.edu
FORCE_HTTPS=true

# Sentry is enabled only when APP_ENV is production or staging and APP_DEBUG=false.
# Leave the DSN empty in local and testing environments.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_STATUS_CHECK_ENABLED=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mis_service_request
DB_USERNAME=
DB_PASSWORD=
DB_READ_HOST=127.0.0.1
DB_WRITE_HOST=127.0.0.1

CACHE_DRIVER=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_COOKIE=mis_service_request_session_v2
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=secure
BACKUP_RETENTION_DAYS=30
# Use a protected network share or mounted off-site directory in production.
BACKUP_SECONDARY_PATH=
LOGIN_AUDIT_RETENTION_DAYS=365
REVOKED_SESSION_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=730
MYSQLDUMP_PATH=C:\xampp_new\mysql\bin\mysqldump.exe
MYSQL_PATH=C:\xampp_new\mysql\bin\mysql.exe

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MIS Service Request System"

# Production Redis upgrade:
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

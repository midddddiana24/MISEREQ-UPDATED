<?xml version="1.0"?>
<psalm
    totallyTyped="false"
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="app"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="bootstrap"/>
        </ignoreFiles>
    </projectFiles>

    <!-- Ignore Laravel auth() optional chaining false positives -->
    <issueHandlers>
        <UndefinedMethod>
            <errorLevel type="suppress">
                <file name="app/Http/Controllers/AdminServiceRequestController.php"/>
                <file name="app/Http/Controllers/UserDashboardController.php"/>
                <file name="app/Http/Controllers/TechnicianAssignmentController.php"/>
            </errorLevel>
        </UndefinedMethod>
    </issueHandlers>
</psalm>
